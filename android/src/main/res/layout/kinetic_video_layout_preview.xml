<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <RelativeLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

    </RelativeLayout>

    <!-- Semi-transparent blackout overlay (关灯模式). -->
    <View
        android:id="@+id/kinetic_blackout_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Danmaku + watermark follow window fullscreen via player layout clone. -->
    <FrameLayout
        android:id="@+id/kinetic_overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <master.flame.danmaku.ui.widget.DanmakuView
            android:id="@+id/kinetic_danmaku_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/kinetic_watermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:visibility="gone" />

        <include layout="@layout/kinetic_ad_overlay" />
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:visibility="invisible">

        <!-- Progress row: play | time | seek | time | rate | settings | volume | fullscreen -->
        <LinearLayout
            android:id="@+id/progress_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/toolbar_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_play_pause_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/kinetic_ic_play" />

            <TextView
                android:id="@+id/current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="00:00"
                android:textColor="#ffffff"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@null"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressDrawable="@drawable/kinetic_seek_progress"
                android:thumb="@drawable/kinetic_seek_thumb" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="00:00"
                android:textColor="#ffffff"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rate_trigger"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/kinetic_rate_icon"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quality_trigger"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/kinetic_quality_icon"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/kinetic_quality_auto"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/settings_trigger"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_settings_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/kinetic_ic_settings" />

            <ImageView
                android:id="@+id/volume_trigger"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_volume_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/kinetic_ic_volume_on" />

            <ImageView
                android:id="@+id/fullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_fullscreen_icon"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/video_enlarge" />
        </LinearLayout>

        <!-- Danmaku row: 弹幕 | 输入 | 发送 | 字幕 -->
        <LinearLayout
            android:id="@+id/danmaku_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/danmaku_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_danmaku_toggle"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/kinetic_ic_danmaku_on" />

            <EditText
                android:id="@+id/danmaku_input"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/kinetic_danmaku_input_bg"
                android:hint="@string/kinetic_danmaku_hint"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="12sp"
                />

            <TextView
                android:id="@+id/danmaku_send"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:text="@string/kinetic_danmaku_send"
                android:textColor="@color/kinetic_seek_active"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/subtitle_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/kinetic_subtitle_toggle"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/kinetic_ic_subtitle_on" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/audio_panel"
        layout="@layout/kinetic_audio_panel"
        android:layout_width="@dimen/kinetic_audio_panel_width"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_bottom"
        android:layout_marginBottom="@dimen/kinetic_panel_popup_margin_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone" />

    <include
        android:id="@+id/settings_panel"
        layout="@layout/kinetic_settings_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_bottom"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/kinetic_panel_popup_margin_bottom"
        android:visibility="gone" />

    <include
        android:id="@+id/rate_panel"
        layout="@layout/kinetic_rate_panel"
        android:layout_width="@dimen/kinetic_option_panel_width"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_bottom"
        android:layout_marginBottom="@dimen/kinetic_panel_popup_margin_bottom"
        android:visibility="gone" />

    <include
        android:id="@+id/quality_panel"
        layout="@layout/kinetic_quality_panel"
        android:layout_width="@dimen/kinetic_option_panel_width"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_bottom"
        android:layout_marginBottom="@dimen/kinetic_panel_popup_margin_bottom"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/bottom_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_alignParentBottom="true"
        android:max="100"
        android:progressDrawable="@drawable/video_progress" />

    <ImageView
        android:id="@+id/back_tiny"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />


    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:visibility="invisible" />


    <ImageView
        android:id="@+id/start"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical"
        android:src="@drawable/video_click_play_selector" />


    <ImageView
        android:id="@+id/small_close"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_small_close"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/lock_screen"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="50dp"
        android:scaleType="centerInside"
        android:src="@drawable/unlock"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/back_tiny"
        android:layout_toRightOf="@+id/back_tiny"
        android:background="@drawable/video_title_bg"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:paddingLeft="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/video_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>


    <RelativeLayout
        android:id="@+id/preview_layout"
        android:layout_width="@dimen/seek_bar_image"
        android:layout_height="100dp"
        android:layout_above="@+id/layout_bottom"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />
    </RelativeLayout>

</RelativeLayout>
