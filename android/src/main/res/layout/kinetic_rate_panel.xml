<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/kinetic_option_panel_width"
    android:layout_height="wrap_content"
    android:background="@drawable/kinetic_audio_panel_bg"
    android:orientation="vertical"
    android:padding="@dimen/kinetic_settings_panel_padding">

    <TextView
        android:id="@+id/rate_panel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kinetic_rate_title"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rate_panel_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
